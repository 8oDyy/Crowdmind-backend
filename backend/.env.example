APP_NAME=CrowdMind API
ENV=dev
API_PREFIX=/api/v1

# Pi heuristic engine — fallback HTTP (si pas de tunnel WS)
CROWDMIND_PI_URL=http://<IP_DU_PI>:5000
PI_TIMEOUT=30.0
# Token d'auth pour le WebSocket Pi (laisser vide pour désactiver l'auth)
PI_TOKEN=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=public

CORS_ORIGINS=*
LOG_LEVEL=INFO

# LLM — Groq (cloud)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LLM — Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
