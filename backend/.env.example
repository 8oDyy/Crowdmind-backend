APP_NAME=CrowdMind API
ENV=dev
API_PREFIX=/api/v1

# Pi heuristic engine (connexion exclusivement en WebSocket inverse)
PI_TIMEOUT=30.0
# Token d'auth pour le WebSocket Pi (laisser vide pour désactiver l'auth)
PI_TOKEN=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=public

CORS_ORIGINS=*
LOG_LEVEL=INFO
